# DevTechSoft — Production Environment Configuration Example
# Copy this file to .env.local for local overrides.
# NOTE: All demo applications function 100% offline out-of-the-box using local persistent storage.

# General App Metadata
VITE_APP_NAME="DevTechSoft"
VITE_APP_URL="https://devtechsoft.dev"
VITE_SUPPORT_EMAIL="hello@devtechsoft.dev"

# Optional: Real OpenAI API Integration for NexaAI Support Agent Demo
# If unset, NexaAI automatically utilizes its deterministic enterprise mock reasoning adapter.
VITE_OPENAI_API_KEY=""
VITE_OPENAI_MODEL="gpt-4o"

# Optional: External Lead Notification Webhook / Email Service (e.g. Resend, Slack Webhook)
# If unset, contact inquiries are safely stored in browser client memory for review & export.
VITE_CONTACT_WEBHOOK_URL=""

# Optional: Microsoft 365 / Dataverse Tenant Metadata for Production Deployment
VITE_DATAVERSE_TENANT_ID=""
VITE_DATAVERSE_CLIENT_ID=""

# Optional: ServiceNow Production Instance Host
VITE_SERVICENOW_INSTANCE_HOST=""
